% goldsteinnotes.sty -- shared preamble for the HC 6001 lecture-note transcriptions.
%
% Reference textbook (Stage 4a): Goldstein, Poole & Safko, "Classical Mechanics,"
% 3rd ed. (Addison-Wesley). The lecturer names Goldstein explicitly in the notes
% (a "NOTATION: Goldstein | Others" box in the scattering lecture) and numbers
% chapters against him.
%
% SCOPE -- READ BEFORE USING. Goldstein is the batch reference for terminology,
% equation style and structural vocabulary ONLY. He is NOT authoritative over
% symbols: the Stage 4a review panel established that the four lectures are
% internally consistent and MUTUALLY INCONSISTENT BY DESIGN, and that the
% lecturer's own symbol wins wherever it differs from Goldstein's.
%
% Consequently this file deliberately defines NO macro that binds a physical
% quantity to a particular letter. An earlier draft defined \reduced as \mu and
% \lang as \ell batch-wide; the panel showed that would silently rewrite the
% scattering lecture's m into mu, and would merge angular momentum with the
% lengths written l in the oscillations and rotations lectures. Such a macro is
% a content edit disguised as notation. Per-lecture symbols are declared in each
% document's own preamble, governed by SYMBOL_CONVENTIONS.md.

\ProvidesPackage{goldsteinnotes}[2026/07/30 HC6001 typesetting conventions]

\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{bm}
\RequirePackage{graphicx}
\RequirePackage[margin=1in]{geometry}
\RequirePackage{enumitem}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage{caption}
\RequirePackage[normalem]{ulem}     % \sout, for material the lecturer struck out
\RequirePackage[hidelinks]{hyperref}

\captionsetup{font=small,labelfont=bf,width=0.92\textwidth}
\setlist{itemsep=2pt,topsep=3pt,parsep=0pt}
\allowdisplaybreaks[1]

% --- structural asides used by the lecturer --------------------------------
\theoremstyle{remark}
\newtheorem{remark}{Remark}
\newtheorem{caveat}{Caveat}
\newtheorem*{aside}{Aside}

% --- struck-out / retracted material ---------------------------------------
% The lecturer strikes results out by hand (e.g. the red X over part of the
% MIDTERM REMARK on the scattering lecture's last page). Struck material is
% preserved and marked as retracted -- never deleted, never silently promoted
% back to valid content.
\newcommand{\retracted}[1]{\sout{#1}}
\newcommand{\retractednote}{\textsuperscript{\,[struck out in the original]}}

% --- notation-neutral typesetting shorthands -------------------------------
% These take the symbol as an argument; they never choose one.
\newcommand{\vect}[1]{\bm{#1}}
\newcommand{\unit}[1]{\hat{\bm{#1}}}
\newcommand{\mat}[1]{\mathsf{#1}}
\renewcommand{\d}{\mathrm{d}}
\newcommand{\dd}[2]{\frac{\d #1}{\d #2}}
\newcommand{\ddn}[3]{\frac{\d^{#3} #1}{\d #2^{#3}}}
\newcommand{\pd}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\pdn}[3]{\frac{\partial^{#3} #1}{\partial #2^{#3}}}
\newcommand{\ddt}[1]{\frac{\d #1}{\d t}}
\newcommand{\evalat}[2]{\left.#1\right|_{#2}}   % held-fixed variable labels

% Inexact differential, for the thermodynamics detour that motivates the
% Legendre transformation (dbar Q, dbar W -- not plain dQ, dW).
\newcommand{\dbar}{\mathchar'26\mkern-12mu \mathrm{d}}

% Boxed results, matching the lecturer's habit of boxing key equations.
\newcommand{\boxeq}[1]{\boxed{#1}}

\endinput
